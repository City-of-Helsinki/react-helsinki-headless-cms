{
  "name": "@city-of-helsinki/react-helsinki-headless-cms",
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@11.9.0",
  "version": "4.0.3",
  "description": "React components for displaying Headless CMS content according to guidelines set by HDS",
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm run storybook",
    "dev:no-open": "pnpm run storybook --no-open",
    "typecheck": "tsc --project ./tsconfig.json --noEmit --declaration false",
    "lint": "eslint src && prettier ./src -c",
    "lint-fix": "eslint src --fix && prettier ./src -w",
    "test": "vitest",
    "test:staged": "vitest related --passWithNoTests",
    "test-storybook": "test-storybook",
    "test:coverage": "vitest run --coverage",
    "build": "rollup -c --bundleConfigAsCjs",
    "docker:dev": "cross-env DOCKER_TARGET=development docker compose up",
    "docker:prod": "cross-env DOCKER_TARGET=production docker compose up",
    "docker:down": "docker compose down --remove-orphans",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:graphql": "cross-env DOTENV_CONFIG_PATH=./.env graphql-codegen -r dotenv/config --config codegen.yml"
  },
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./apollo": {
      "import": "./dist/apollo.js",
      "default": "./dist/cjs/apollo.js"
    },
    "./nextjs": {
      "import": "./dist/nextjs.js",
      "default": "./dist/cjs/nextjs.js"
    }
  },
  "repository": "https://github.com/City-of-Helsinki/react-helsinki-headless-cms.git",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/City-of-Helsinki/react-helsinki-headless-cms/issues"
  },
  "homepage": "https://github.com/City-of-Helsinki/react-helsinki-headless-cms#readme",
  "peerDependencies": {
    "@apollo/client": "^3.14.0",
    "hds-react": "^6.0.5",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@apollo/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apollo/client": "^3.14.1",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@chromatic-com/storybook": "^4.1.3",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint-react/eslint-plugin": "^4.2.3",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "6.2.1",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^4.4.2",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/addon-webpack5-compiler-babel": "^3.0.6",
    "@storybook/preset-scss": "^1.0.3",
    "@storybook/react-webpack5": "^10.5.10",
    "@storybook/test-runner": "^0.24.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-loader": "^9.2.1",
    "cross-env": "^7.0.3",
    "crypto-browserify": "^3.12.1",
    "css-loader": "^6.11.0",
    "dotenv": "^17.4.2",
    "edit-json-file": "^1.8.1",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "git-rev-sync": "^3.0.2",
    "globals": "^17.12.0",
    "graphql": "^16.14.2",
    "hds-core": "^6.0.5",
    "hds-react": "^6.0.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-scss": "^4.0.9",
    "prettier": "3.7.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "rollup": "^4.63.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-includepaths": "^0.2.4",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "sass": "^1.103.1",
    "sass-loader": "^13.3.3",
    "storybook": "^10.5.10",
    "style-loader": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "webpack": "^5.110.3"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "doctoc": "^2.5.0",
    "hds-design-tokens": "^6.0.5",
    "html-entities": "^2.6.0",
    "html-react-parser": "^5.2.17",
    "isomorphic-dompurify": "^2.36.0",
    "lodash-es": "^4.18.1",
    "msw": "^2.15.0"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,cjs,mjs}": [
      "eslint --fix",
      "prettier --write",
      "pnpm run test:staged"
    ]
  }
}
